# Copy to .env and adjust as needed: cp .env.example .env

# PostgreSQL container
POSTGRES_DB=wexPurchases
POSTGRES_USER=wexPurchasesUser
POSTGRES_PASSWORD=changeme

# Application datasource (username/password/db must match the PostgreSQL values above)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/wexPurchases
SPRING_DATASOURCE_USERNAME=wexPurchasesUser
SPRING_DATASOURCE_PASSWORD=changeme

# Treasury Reporting Rates of Exchange API
TREASURY_API_BASE_URL=https://api.fiscaldata.treasury.gov/services/api/fiscal_service
